flowchart TB
    subgraph 数据源层["数据源层 (disney_knowledge_base/)"]
        DOCX["Word 文档 (.docx)<br/>门票规则 / 攻略 / 老人票 / 酒店会员"]
        IMG["本地图片 (.jpg/.jpeg)<br/>万圣节海报 / 活动海报"]
        VIDEO["远程视频 URL<br/>腾讯云 COS mp4"]
    end

    subgraph 索引构建["索引构建阶段 (4-disney_build_index.py)"]
        PARSE["DOCX 解析<br/>python-docx"]
        CHUNK["文本切分<br/>chunk=500, overlap=50"]
        EMB_BUILD["多模态向量化<br/>tongyi-embedding-vision-plus"]
        FAISS_BUILD["FAISS 向量索引<br/>IndexFlatL2 (L2距离)"]
        META["元数据存储<br/>disney_metadata.json"]
        INDEX["向量索引文件<br/>disney_index.faiss"]
    end

    subgraph 查询推理["查询推理阶段 (5-disney_query.py)"]
        QUERY["用户 Query"]
        EMB_QUERY["Query 向量化<br/>tongyi-embedding-vision-plus"]
        SEARCH["FAISS 全量检索<br/>L2距离 → 相似度"]
        INTENT["意图检测<br/>图片/视频关键词"]
        TOPK["Top-K 文本召回<br/>构建 RAG Context"]
        MEDIA["媒体匹配<br/>距离阈值 < 3.0"]
        LLM["大模型生成<br/>qwen-flash"]
        ANSWER["最终答案<br/>文本 + 图片路径/视频URL"]
    end

    subgraph 外部服务["阿里云 DashScope API"]
        API_EMB["MultiModalEmbedding API<br/>文本 / 图片 / 视频 统一向量空间"]
        API_LLM["OpenAI 兼容接口<br/>Chat Completions"]
    end

    subgraph 技术验证["技术验证脚本 (独立 Demo)"]
        DEMO1["1-文本embedding.py"]
        DEMO2["2-图片embedding.py"]
        DEMO3["3-视频embedding.py"]
    end

    DOCX --> PARSE --> CHUNK --> EMB_BUILD
    IMG --> EMB_BUILD
    VIDEO --> EMB_BUILD
    EMB_BUILD --> API_EMB
    EMB_BUILD --> FAISS_BUILD
    EMB_BUILD --> META
    FAISS_BUILD --> INDEX

    QUERY --> EMB_QUERY --> API_EMB
    INDEX --> SEARCH
    META --> SEARCH
    EMB_QUERY --> SEARCH
    SEARCH --> INTENT
    SEARCH --> TOPK
    SEARCH --> MEDIA
    TOPK --> LLM
    LLM --> API_LLM
    LLM --> ANSWER
    MEDIA --> ANSWER

    DEMO1 --> API_EMB
    DEMO2 --> API_EMB
    DEMO3 --> API_EMB
